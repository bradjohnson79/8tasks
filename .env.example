# Copy to .env.local for local development. Never commit real values.

# Runtime connection used by the app. MUST be a non-owner role that is a member
# of `app_runtime`, so row-level security applies. Use Neon's pooled host in production.
DATABASE_URL=postgres://eighttasks_app:app_local_pw@localhost:5432/eighttasks

# Admin connection: a login role that is a member of `app_admin`. Used ONLY by
# admin server code after a server-side admin + MFA check (src/lib/admin.ts).
ADMIN_DATABASE_URL=postgres://eighttasks_admin:admin_local_pw@localhost:5432/eighttasks

# Owner connection, used only by migrations and seeds (drizzle-kit, scripts/).
# Never set this in the Vercel runtime environment.
MIGRATION_DATABASE_URL=postgres://eighttasks_owner:owner_local_pw@localhost:5432/eighttasks

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Public base URL of the site (no trailing slash). Leave UNSET on Vercel previews:
# the app then uses Vercel's VERCEL_BRANCH_URL / VERCEL_URL automatically.
BETTER_AUTH_URL=http://localhost:3000

# Demo/seed data visibility. Ignored (forced off) when VERCEL_ENV=production.
SHOW_DEMO_DATA=true
